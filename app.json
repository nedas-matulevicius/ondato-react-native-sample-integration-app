{
  "expo": {
    "name": "RNSampleIntegrationApp",
    "slug": "RNSampleIntegrationApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rnsampleintegrationapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ondato.rnsampleintegrationapp"
    },
    "android": {
      "package": "com.ondato.rnsampleintegrationapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "ondato-sdk-react-native",
        {
          "enableNfc": false,
          "enableScreenRecorder": false,
          "enableDocumentResolver": true,
          "customFontsPath": "./assets/fonts",
          "ios": {
            "cameraUsageDescription": "Allow RNSampleIntegrationApp to capture your identity document and selfie."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
